<!--
    Proxy Settings Dialog
    Add/Edit proxy configurations
-->
<Window x:Class="MyFastDownloader.App.Views.ProxySettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🌐 Proxy Configuration"
        Height="650"
        Width="600"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#60A5FA"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#475569"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#64748B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern PasswordBox Style -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Border Background="#0F172A"
            CornerRadius="16"
            BorderBrush="#334155"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30"
                            ShadowDepth="8"
                            Color="Black"
                            Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="#1E293B"
                    CornerRadius="16,16,0,0"
                    Padding="20,16">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌐"
                                 FontSize="24"
                                 Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TitleTextBlock"
                                     Text="Proxy Configuration"
                                     FontSize="18"
                                     FontWeight="Bold"
                                     Foreground="White"/>
                            <TextBlock Text="Configure proxy settings for downloads"
                                     FontSize="12"
                                     Foreground="#94A3B8"
                                     Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button HorizontalAlignment="Right"
                            Width="32"
                            Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CancelButton_Click">
                        <TextBlock Text="✕"
                                 FontSize="16"
                                 Foreground="White"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1"
                         VerticalScrollBarVisibility="Auto"
                         Padding="20">
                <StackPanel>
                    <!-- Name -->
                    <TextBlock Text="Configuration Name"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Foreground="#E2E8F0"
                             Margin="0,0,0,8"/>
                    <TextBox x:Name="NameTextBox"
                            Style="{StaticResource ModernTextBox}"
                            Margin="0,0,0,16"/>

                    <!-- Proxy Type -->
                    <TextBlock Text="Proxy Type *"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Foreground="#E2E8F0"
                             Margin="0,0,0,8"/>
                    <ComboBox x:Name="ProxyTypeComboBox"
                             Style="{StaticResource ModernComboBox}"
                             SelectionChanged="ProxyTypeComboBox_SelectionChanged"
                             Margin="0,0,0,16"/>

                    <!-- Proxy Details Panel -->
                    <StackPanel x:Name="ProxyDetailsPanel" Visibility="Collapsed">
                        <!-- Host -->
                        <TextBlock Text="Proxy Host/IP *"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Foreground="#E2E8F0"
                                 Margin="0,0,0,8"/>
                        <TextBox x:Name="HostTextBox"
                                Style="{StaticResource ModernTextBox}"
                                Margin="0,0,0,16"/>

                        <!-- Port -->
                        <TextBlock Text="Proxy Port *"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Foreground="#E2E8F0"
                                 Margin="0,0,0,8"/>
                        <TextBox x:Name="PortTextBox"
                                Style="{StaticResource ModernTextBox}"
                                Text="8080"
                                Margin="0,0,0,16"/>

                        <!-- Authentication -->
                        <CheckBox x:Name="RequiresAuthCheckBox"
                                Content="Requires Authentication"
                                Foreground="White"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Margin="0,0,0,16"
                                Checked="RequiresAuthCheckBox_Changed"
                                Unchecked="RequiresAuthCheckBox_Changed"/>

                        <!-- Auth Details Panel -->
                        <StackPanel x:Name="AuthDetailsPanel" Visibility="Collapsed">
                            <!-- Username -->
                            <TextBlock Text="Username *"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     Foreground="#E2E8F0"
                                     Margin="0,0,0,8"/>
                            <TextBox x:Name="UsernameTextBox"
                                    Style="{StaticResource ModernTextBox}"
                                    Margin="0,0,0,16"/>

                            <!-- Password -->
                            <TextBlock Text="Password *"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     Foreground="#E2E8F0"
                                     Margin="0,0,0,8"/>
                            <PasswordBox x:Name="PasswordBox"
                                        Style="{StaticResource ModernPasswordBox}"
                                        Margin="0,0,0,16"/>
                        </StackPanel>

                        <!-- Bypass List -->
                        <TextBlock Text="Bypass List (optional)"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Foreground="#E2E8F0"
                                 Margin="0,0,0,8"/>
                        <TextBlock Text="Semicolon-separated domains: *.local;*.company.com;192.168.*"
                                 FontSize="11"
                                 Foreground="#64748B"
                                 Margin="0,0,0,8"/>
                        <TextBox x:Name="BypassListTextBox"
                                Style="{StaticResource ModernTextBox}"
                                Margin="0,0,0,16"/>

                        <!-- Bypass Local -->
                        <CheckBox x:Name="BypassLocalCheckBox"
                                Content="Bypass proxy for local addresses"
                                Foreground="White"
                                FontSize="13"
                                IsChecked="True"
                                Margin="0,0,0,16"/>
                    </StackPanel>

                    <!-- Test URL -->
                    <TextBlock Text="Test URL (for connection testing)"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Foreground="#E2E8F0"
                             Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TestUrlTextBox"
                                Grid.Column="0"
                                Style="{StaticResource ModernTextBox}"
                                Text="https://www.google.com"/>

                        <Button Grid.Column="1"
                                Content="🔍 Test"
                                Style="{StaticResource ModernButton}"
                                Background="#F59E0B"
                                Margin="10,0,0,0"
                                Click="TestButton_Click"/>
                    </Grid>

                    <!-- Notes -->
                    <TextBlock Text="Notes (optional)"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Foreground="#E2E8F0"
                             Margin="0,0,0,8"/>
                    <TextBox x:Name="NotesTextBox"
                            Style="{StaticResource ModernTextBox}"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            Height="60"
                            Margin="0,0,0,16"/>

                    <!-- Active -->
                    <CheckBox x:Name="IsActiveCheckBox"
                            Content="Set as active proxy"
                            Foreground="White"
                            FontSize="13"
                            FontWeight="SemiBold"
                            IsChecked="True"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="#1E293B"
                    BorderBrush="#334155"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16"
                    Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status Message -->
                    <TextBlock x:Name="StatusTextBlock"
                             Grid.Column="0"
                             Text=""
                             FontSize="12"
                             Foreground="#94A3B8"
                             VerticalAlignment="Center"/>

                    <!-- Save Button -->
                    <Button Grid.Column="1"
                            Content="✓ Save"
                            Style="{StaticResource ModernButton}"
                            Background="#10B981"
                            MinWidth="100"
                            Click="SaveButton_Click"/>

                    <!-- Cancel Button -->
                    <Button Grid.Column="2"
                            Content="✗ Cancel"
                            Style="{StaticResource ModernButton}"
                            MinWidth="100"
                            Margin="10,0,0,0"
                            Click="CancelButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
