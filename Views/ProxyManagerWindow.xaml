<!--
    Proxy Manager Window
    Manages all proxy configurations
-->
<Window x:Class="MyFastDownloader.App.Views.ProxyManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🌐 Quản Lý Proxy - MyFastDownloader"
        Height="600"
        Width="950"
        MinHeight="500"
        MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#60A5FA"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>

        <!-- Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#475569"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#64748B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Icon Button Style -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
    </Window.Resources>

    <Border Background="#0F172A"
            CornerRadius="16"
            BorderBrush="#334155"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30"
                            ShadowDepth="8"
                            Color="Black"
                            Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="#1E293B"
                    CornerRadius="16,16,0,0"
                    Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Background="White"
                                CornerRadius="8"
                                Width="32"
                                Height="32"
                                Margin="0,0,12,0">
                            <TextBlock Text="🌐"
                                     FontSize="18"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Quản Lý Proxy"
                                     FontSize="18"
                                     FontWeight="Bold"
                                     Foreground="White"/>
                            <TextBlock x:Name="SubtitleTextBlock"
                                     Text="0 proxy configurations"
                                     FontSize="12"
                                     Foreground="#94A3B8"
                                     Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="32"
                            Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <TextBlock Text="✕"
                                 FontSize="16"
                                 Foreground="White"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchTextBox"
                             Grid.Column="0"
                             Background="#334155"
                             Foreground="White"
                             BorderBrush="#475569"
                             BorderThickness="2"
                             Padding="12,8"
                             FontSize="13"
                             TextChanged="SearchTextBox_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8">
                                                <Grid>
                                                    <TextBlock Text="🔍 Tìm kiếm proxy..."
                                                             Foreground="#64748B"
                                                             FontSize="13"
                                                             Margin="12,0,0,0"
                                                             VerticalAlignment="Center"
                                                             IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                Margin="{TemplateBinding Padding}"
                                                                VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Button Grid.Column="1"
                            Content="🔄 Refresh"
                            Style="{StaticResource ModernButton}"
                            Margin="10,0,0,0"
                            Click="RefreshButton_Click"/>

                    <Button Grid.Column="2"
                            Content="➕ Thêm Mới"
                            Style="{StaticResource ModernButton}"
                            Background="#10B981"
                            Margin="10,0,0,0"
                            Click="AddButton_Click"/>
                </Grid>

                <!-- Proxy List -->
                <Border Grid.Row="1"
                        Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <!-- ListView -->
                        <ListView x:Name="ProxiesListView"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  SelectionChanged="ProxiesListView_SelectionChanged">
                            <ListView.Resources>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#334155"/>
                                    <Setter Property="Padding" Value="16,12"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="#3B82F6" Opacity="0.06"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="#3B82F6" Opacity="0.12"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.Resources>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Info -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DisplayText}"
                                                     FontSize="14"
                                                     FontWeight="SemiBold"
                                                     Foreground="White"/>
                                            <TextBlock FontSize="12"
                                                     Foreground="#94A3B8"
                                                     Margin="0,4,0,0">
                                                <Run Text="{Binding ProxyAddress}"/>
                                                <Run Text="•"/>
                                                <Run Text="Used:"/>
                                                <Run Text="{Binding UseCount}"/>
                                                <Run Text="times"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="1"
                                                CornerRadius="10"
                                                Padding="8,4"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#10B981"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#64748B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11"
                                                     FontWeight="Bold"
                                                     Foreground="White">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="✓ Active"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text" Value="○ Inactive"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Edit Button -->
                                        <Button Grid.Column="2"
                                                Content="✎"
                                                Style="{StaticResource IconButton}"
                                                Background="#475569"
                                                Margin="10,0,0,0"
                                                ToolTip="Chỉnh sửa"
                                                Click="EditButton_Click"
                                                Tag="{Binding}"/>

                                        <!-- Toggle Button -->
                                        <Button Grid.Column="3"
                                                Margin="6,0,0,0"
                                                Click="ToggleButton_Click"
                                                Tag="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="Background" Value="#F59E0B"/>
                                                    <Setter Property="Content" Value="⏸"/>
                                                    <Setter Property="ToolTip" Value="Vô hiệu hóa"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Content" Value="▶"/>
                                                            <Setter Property="ToolTip" Value="Kích hoạt"/>
                                                            <Setter Property="Background" Value="#10B981"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Delete Button -->
                                        <Button Grid.Column="4"
                                                Content="🗑"
                                                Style="{StaticResource IconButton}"
                                                Background="#EF4444"
                                                Margin="6,0,0,0"
                                                ToolTip="Xóa"
                                                Click="DeleteButton_Click"
                                                Tag="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty State -->
                        <StackPanel x:Name="EmptyStatePanel"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock Text="🌐"
                                     FontSize="48"
                                     HorizontalAlignment="Center"
                                     Opacity="0.3"
                                     Margin="0,0,0,16"/>
                            <TextBlock Text="Chưa có proxy nào"
                                     FontSize="16"
                                     FontWeight="SemiBold"
                                     Foreground="#64748B"
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="Click 'Thêm Mới' để tạo proxy đầu tiên"
                                     FontSize="13"
                                     Foreground="#64748B"
                                     HorizontalAlignment="Center"
                                     Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="#1E293B"
                    BorderBrush="#334155"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16"
                    Padding="20,16">
                <Grid>
                    <TextBlock x:Name="StatusTextBlock"
                             Text="Sẵn sàng"
                             FontSize="12"
                             Foreground="#94A3B8"
                             VerticalAlignment="Center"/>

                    <Button HorizontalAlignment="Right"
                            Content="✓ Đóng"
                            Style="{StaticResource ModernButton}"
                            MinWidth="100"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
