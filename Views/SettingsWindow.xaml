<!--
    MyFastDownloader - Modern Settings Window
    Features: Glassmorphism, smooth animations, modern design
    Consistent with MainWindow styling
-->
<Window x:Class="MyFastDownloader.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚙ Cài đặt - MyFastDownloader" 
        Height="600" 
        Width="750"
        MinHeight="550"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Modern Color Palette (Consistent with MainWindow) -->
        <Color x:Key="PrimaryDark">#0F172A</Color>
        <Color x:Key="SecondaryDark">#1E293B</Color>
        <Color x:Key="AccentDark">#334155</Color>
        <Color x:Key="AccentLight">#475569</Color>
        <Color x:Key="TextPrimary">#E2E8F0</Color>
        <Color x:Key="TextSecondary">#94A3B8</Color>
        <Color x:Key="TextMuted">#64748B</Color>
        <Color x:Key="AccentBlue">#60A5FA</Color>
        <Color x:Key="Success">#10B981</Color>
        <Color x:Key="Warning">#F59E0B</Color>

        <!-- Gradients -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#334155" Offset="0"/>
            <GradientStop Color="#475569" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#475569" Offset="0"/>
            <GradientStop Color="#64748B" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#10B981" Offset="0"/>
            <GradientStop Color="#059669" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WarningGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F59E0B" Offset="0"/>
            <GradientStop Color="#D97706" Offset="1"/>
        </LinearGradientBrush>

        <!-- Fade In Animation -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                           From="20" To="0" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource ButtonGradient}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                CornerRadius="12" 
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" 
                                                ShadowDepth="3" 
                                                Color="#000000" 
                                                Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-2"/>
                                    </Setter.Value>
                                </Setter>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                           To="-2" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                           To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        </Style>

        <!-- Preset Button Style (Smaller, Pill-shaped) -->
        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="White" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="White" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="White" Opacity="0.12"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush">
                                    <Setter.Value>
                                        <SolidColorBrush Color="White" Opacity="0.25"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Slider Style -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="#60A5FA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="4"
                                    Height="8"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Style>
                                            <Style TargetType="RepeatButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Border Background="#60A5FA" 
                                                                    CornerRadius="4,0,0,4"
                                                                    Height="8">
                                                                <Border.Effect>
                                                                    <DropShadowEffect Color="#60A5FA" 
                                                                                    BlurRadius="8" 
                                                                                    ShadowDepth="0" 
                                                                                    Opacity="0.5"/>
                                                                </Border.Effect>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RepeatButton.Style>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="18" 
                                                       Height="18" 
                                                       Fill="White"
                                                       Cursor="Hand">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="8" 
                                                                        ShadowDepth="0" 
                                                                        Color="#60A5FA" 
                                                                        Opacity="0.7"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Style>
                                            <Style TargetType="RepeatButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Border Background="Transparent" Height="8"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RepeatButton.Style>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern CheckBox Style -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="CheckBorder"
                                    Grid.Column="0"
                                    Width="20"
                                    Height="20"
                                    CornerRadius="5"
                                    Background="#374151"
                                    BorderBrush="#475569"
                                    BorderThickness="2"
                                    Margin="0,0,10,0">
                                <TextBlock x:Name="CheckMark"
                                         Text="✓"
                                         FontSize="12"
                                         FontWeight="Bold"
                                         Foreground="White"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Opacity="0"/>
                            </Border>

                            <ContentPresenter Grid.Column="1" 
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding Content}"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#10B981"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#10B981"/>
                                <Setter TargetName="CheckMark" Property="Opacity" Value="1"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckMark"
                                                           Storyboard.TargetProperty="Opacity"
                                                           To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Card Style (Glassmorphism) -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="White" Opacity="0.05"/>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="White" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" 
                                    ShadowDepth="3" 
                                    Color="#000000" 
                                    Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Section Label Style -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- Help Text Style -->
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="#0F172A" 
            CornerRadius="20" 
            BorderBrush="#334155" 
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" 
                            ShadowDepth="10" 
                            Color="#000000" 
                            Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with Close Button -->
            <Border Grid.Row="0" 
                    Background="{StaticResource HeaderGradient}" 
                    CornerRadius="20,20,0,0"
                    Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title Section -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Background="White" 
                                CornerRadius="8" 
                                Width="32" 
                                Height="32" 
                                Margin="0,0,12,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" 
                                                ShadowDepth="2" 
                                                Color="#3B82F6" 
                                                Opacity="0.4"/>
                            </Border.Effect>
                            <TextBlock Text="⚙" 
                                     FontSize="18" 
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Cài đặt" 
                                     FontSize="20" 
                                     FontWeight="Bold" 
                                     Foreground="White"/>
                            <TextBlock Text="Tùy chỉnh MyFastDownloader" 
                                     FontSize="12" 
                                     Foreground="#94A3B8" 
                                     Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="1"
                            Width="32"
                            Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CancelButton_Click"
                            ToolTip="Đóng (ESC)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="8">
                                    <TextBlock Text="✕" 
                                             FontSize="16" 
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="White" Opacity="0.1"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content with ScrollViewer -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          Padding="20,16"
                          Background="#1E293B">
                <ScrollViewer.RenderTransform>
                    <TranslateTransform Y="0"/>
                </ScrollViewer.RenderTransform>

                <StackPanel>
                    <!-- Download Folder Section -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="📁 Thư mục tải xuống" 
                                     Style="{StaticResource SectionHeader}"/>

                            <TextBlock Text="Thư mục mặc định:" 
                                     Style="{StaticResource SectionLabel}"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="DefaultFolderTextBox"
                                         Grid.Column="0"
                                         Text="{Binding DefaultDownloadFolder, Mode=TwoWay}"
                                         IsReadOnly="True"
                                         Style="{StaticResource ModernTextBox}"/>

                                <Button Grid.Column="1"
                                        Content="📂 Chọn"
                                        Style="{StaticResource ModernButton}"
                                        Margin="10,0,0,0"
                                        Padding="12,8"
                                        Click="BrowseFolderButton_Click"/>

                                <Button Grid.Column="2"
                                        Content="↻ Mặc định"
                                        Style="{StaticResource ModernButton}"
                                        Margin="10,0,0,0"
                                        Padding="12,8"
                                        Click="ResetFolderButton_Click"/>
                            </Grid>

                            <CheckBox x:Name="AlwaysAskCheckBox"
                                      Content="Luôn hỏi vị trí lưu file"
                                      IsChecked="{Binding AlwaysAskSaveLocation, Mode=TwoWay}"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0,0,0,12"/>

                            <TextBlock Style="{StaticResource HelpText}"
                                       Margin="36,0,0,0">
                                <Run Text="💡"/>
                                <Run Text="Nếu bật, bạn sẽ được hỏi vị trí lưu mỗi khi thêm download mới. Nếu tắt, file sẽ tự động lưu vào thư mục mặc định."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Speed Limiting Section -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="⚡ Giới hạn tốc độ" 
                                     Style="{StaticResource SectionHeader}"/>

                            <CheckBox x:Name="EnableSpeedLimitCheckBox"
                                      Content="Bật giới hạn tốc độ toàn cục"
                                      IsChecked="{Binding EnableSpeedLimit, Mode=TwoWay}"
                                      Style="{StaticResource ModernCheckBox}"
                                      FontWeight="SemiBold"
                                      Margin="0,0,0,20"
                                      Checked="EnableSpeedLimitCheckBox_Changed"
                                      Unchecked="EnableSpeedLimitCheckBox_Changed"/>

                            <!-- Speed Limit Controls -->
                            <StackPanel x:Name="SpeedLimitControlsPanel" 
                                        IsEnabled="{Binding EnableSpeedLimit}">
                                <TextBlock Text="Tốc độ tối đa:" 
                                         Style="{StaticResource SectionLabel}"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                                    <Slider x:Name="SpeedLimitSlider"
                                            Grid.Column="0"
                                            Minimum="10"
                                            Maximum="10240"
                                            Value="{Binding GlobalSpeedLimitKBps, Mode=TwoWay}"
                                            Style="{StaticResource ModernSlider}"
                                            VerticalAlignment="Center"/>

                                    <Border Grid.Column="1"
                                            Background="#334155"
                                            CornerRadius="8"
                                            Padding="10,6"
                                            Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal" 
                                                    HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding GlobalSpeedLimitKBps, StringFormat={}{0:F0}}"
                                                     FontSize="14"
                                                     FontWeight="Bold"
                                                     Foreground="#60A5FA"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text=" KB/s"
                                                     FontSize="11"
                                                     Foreground="#94A3B8"
                                                     VerticalAlignment="Center"
                                                     Margin="3,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Quick Presets -->
                                <TextBlock Text="Cài đặt nhanh:" 
                                         Style="{StaticResource SectionLabel}"/>

                                <WrapPanel Margin="0,0,0,16">
                                    <Button Content="128 KB/s" 
                                            Style="{StaticResource PresetButton}"
                                            Margin="0,0,10,10"
                                            Click="SpeedPreset_Click" 
                                            Tag="128"/>
                                    <Button Content="256 KB/s" 
                                            Style="{StaticResource PresetButton}"
                                            Margin="0,0,10,10"
                                            Click="SpeedPreset_Click" 
                                            Tag="256"/>
                                    <Button Content="512 KB/s" 
                                            Style="{StaticResource PresetButton}"
                                            Margin="0,0,10,10"
                                            Click="SpeedPreset_Click" 
                                            Tag="512"/>
                                    <Button Content="1 MB/s" 
                                            Style="{StaticResource PresetButton}"
                                            Margin="0,0,10,10"
                                            Click="SpeedPreset_Click" 
                                            Tag="1024"/>
                                    <Button Content="5 MB/s" 
                                            Style="{StaticResource PresetButton}"
                                            Margin="0,0,10,10"
                                            Click="SpeedPreset_Click" 
                                            Tag="5120"/>
                                    <Button Content="10 MB/s" 
                                            Style="{StaticResource PresetButton}"
                                            Margin="0,0,10,10"
                                            Click="SpeedPreset_Click" 
                                            Tag="10240"/>
                                </WrapPanel>

                                <Border Background="#1E293B"
                                        BorderBrush="#60A5FA"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16">
                                    <TextBlock Style="{StaticResource HelpText}"
                                               Foreground="#94A3B8">
                                        <Run Text="💡" FontSize="14"/>
                                        <Run Text="Giới hạn tốc độ áp dụng cho tất cả downloads mới. Downloads đang chạy sẽ áp dụng giới hạn sau khi tạm dừng và tiếp tục."/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Download Settings Section -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="🔧 Cài đặt tải xuống" 
                                     Style="{StaticResource SectionHeader}"/>

                            <!-- Segments Count -->
                            <TextBlock Text="Số kết nối song song:" 
                                     Style="{StaticResource SectionLabel}"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <Slider x:Name="SegmentCountSlider"
                                        Grid.Column="0"
                                        Minimum="1"
                                        Maximum="16"
                                        Value="{Binding DefaultSegmentCount, Mode=TwoWay}"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Style="{StaticResource ModernSlider}"
                                        VerticalAlignment="Center"/>

                                <Border Grid.Column="1"
                                        Background="#334155"
                                        CornerRadius="8"
                                        Padding="10,6"
                                        Margin="12,0,0,0">
                                    <TextBlock Text="{Binding ElementName=SegmentCountSlider, Path=Value, StringFormat={}{0:F0}}"
                                             FontSize="16"
                                             FontWeight="Bold"
                                             Foreground="#60A5FA"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,24">
                                <Run Text="📊"/>
                                <Run Text="Nhiều kết nối = tải nhanh hơn, nhưng tốn nhiều tài nguyên hơn. Khuyến nghị: 6-8 kết nối."/>
                            </TextBlock>

                            <!-- Max Concurrent Downloads -->
                            <TextBlock Text="Số download đồng thời tối đa:" 
                                     Style="{StaticResource SectionLabel}"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <Slider x:Name="MaxConcurrentSlider"
                                        Grid.Column="0"
                                        Minimum="1"
                                        Maximum="10"
                                        Value="{Binding MaxConcurrentDownloads, Mode=TwoWay}"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Style="{StaticResource ModernSlider}"
                                        VerticalAlignment="Center"/>

                                <Border Grid.Column="1"
                                        Background="#334155"
                                        CornerRadius="8"
                                        Padding="10,6"
                                        Margin="12,0,0,0">
                                    <TextBlock Text="{Binding ElementName=MaxConcurrentSlider, Path=Value, StringFormat={}{0:F0}}"
                                             FontSize="16"
                                             FontWeight="Bold"
                                             Foreground="#60A5FA"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <TextBlock Style="{StaticResource HelpText}">
                                <Run Text="🔄"/>
                                <Run Text="Giới hạn số lượng download chạy cùng lúc để tránh quá tải hệ thống."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Buttons -->
            <Border Grid.Row="2" 
                    Background="#1E293B"
                    BorderBrush="#334155"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,20,20"
                    Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Info Text -->
                    <StackPanel Grid.Column="0" 
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Background="#60A5FA" 
                                Width="5" 
                                Height="5" 
                                CornerRadius="2.5" 
                                Margin="0,0,8,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#60A5FA" 
                                                BlurRadius="6" 
                                                ShadowDepth="0"/>
                            </Border.Effect>
                        </Border>
                        <TextBlock Text="Thay đổi sẽ được áp dụng sau khi lưu" 
                                 FontSize="12" 
                                 Foreground="#94A3B8"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Save Button -->
                    <Button Grid.Column="1"
                            Content="✓ Lưu cài đặt"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource SuccessGradient}"
                            MinWidth="120"
                            Click="SaveButton_Click"/>

                    <!-- Cancel Button -->
                    <Button Grid.Column="2"
                            Content="✗ Hủy"
                            Style="{StaticResource ModernButton}"
                            MinWidth="100"
                            Margin="10,0,0,0"
                            Click="CancelButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
